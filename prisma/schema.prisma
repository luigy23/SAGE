generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PeriodoAcademico {
  id                  String                @id @default(cuid())
  nombre              String                @unique
  fechaInicio         DateTime
  fechaFin            DateTime
  estado              EstadoPeriodo         @default(ABIERTO)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  agendaDesde         DateTime?
  agendaHasta         DateTime?
  monitoreoDesde      DateTime?
  monitoreoHasta      DateTime?
  formulasCurso       FormulaCurso[]
  parametrosGlobales  ParametroGlobal[]
  parametrosModalidad ParametrosModalidad[]

  @@map("periodos_academicos")
}

model CursoMaestro {
  id              String                @id @default(cuid())
  codigo          String                @unique
  nombre          String
  creditos        Int
  tipo            TipoCurso
  estado          Boolean               @default(true)
  componente      ComponenteCurricular?
  facultad        String?
  creditosT       Int?
  creditosP       Int?
  horasSemT       Int?
  horasSemP       Int?
  horasSemI       Int?
  acuerdoOrigen   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  cursosAgenda    CursoAgenda[]
  cursosGuardados CursoGuardado[]

  @@map("cursos_maestro")
}

model Docente {
  id                  String            @id @default(cuid())
  email               String            @unique
  password            String
  nombre              String
  cedula              String            @unique
  rol                 Rol               @default(DOCENTE)
  estadoCuenta        EstadoCuenta      @default(PENDIENTE)
  sedeBase            Sede
  modalidad           Modalidad
  facultad            String
  programa            String
  celular             String?
  doctorado           Boolean           @default(false)
  cargoAdministrativo Boolean           @default(false)
  tipoCargo           String?
  cargoAmbitoTipo     AmbitoCargo?
  cargoAmbitoValor    String?
  proyectosActivos    Boolean           @default(false)
  semanasVinculacion  Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tituloDoctorado     String?
  agendasSemestrales  AgendaSemestral[]
  cursosGuardados     CursoGuardado[]
  monitoreos          Monitoreo[]
  solicitudesCambioPerfil SolicitudCambioPerfil[]
  proyectos           ProyectoDocente[]
  agendasAprobadas    AgendaSemestral[] @relation("AgendaAprobadaPor")
  monitoreosAprobados Monitoreo[]       @relation("MonitoreoAprobadoPor")

  @@map("docentes")
}

model CursoGuardado {
  id                String        @id @default(cuid())
  docenteId         String
  cursoMaestroId    String?
  numeroCurso       String
  nombreCurso       String
  sede              String?
  horasPresenciales Int?
  creditos          Int?
  semanas           Int?
  cursoMaestro      CursoMaestro? @relation(fields: [cursoMaestroId], references: [id])
  docente           Docente       @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  @@map("cursos_guardados")
}

model AgendaSemestral {
  id                          String                      @id @default(cuid())
  docenteId                   String
  periodo                     String
  estado                      EstadoFormulario            @default(BORRADOR)
  observacionesAdmin          String?
  rehabilitada                Boolean                     @default(false)
  rehabilitadaCount           Int                         @default(0)
  ultimaRehabilitacion        DateTime?
  semanasAgenda               Int                         @default(22)
  aprobadoPorId               String?
  aprobadoEn                  DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  otrasActividadesDocencia    ActividadDocencia[]
  actividadesGestion          ActividadGestion[]
  actividadesInvestigacion    ActividadInvestigacion[]
  actividadesProyeccionSocial ActividadProyeccionSocial[]
  docente                     Docente                     @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  aprobadoPor                 Docente?                    @relation("AgendaAprobadaPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  cursos                      CursoAgenda[]
  monitoreo                   Monitoreo?
  rehabilitaciones            RehabilitacionAgenda[]

  @@unique([docenteId, periodo])
  @@map("agendas_semestrales")
}

model CursoAgenda {
  id                String           @id @default(cuid())
  agendaId          String
  cursoMaestroId    String?
  numeroCurso       String
  nombreCurso       String
  creditos          Int
  sede              String?
  horasPresenciales Int
  semanas           Int
  dedicacionPeriodo Float
  agenda            AgendaSemestral  @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  cursoMaestro      CursoMaestro?    @relation(fields: [cursoMaestroId], references: [id], onDelete: Restrict)
  reporteDocencia   ReporteDocencia?

  @@map("cursos_agenda")
}

model ActividadDocencia {
  id                       String                    @id @default(cuid())
  agendaId                 String
  nombre                   String
  descripcion              String?
  dedicacionPeriodo        Float
  cantidadUnidades         Int?
  // Sede de ejecución (Art. 11). Obligatoria solo si el catálogo dice
  // aplicaUnoPorSede=true o topePorUnidad=SEDE. Informativa en el resto.
  sede                     Sede?
  agenda                   AgendaSemestral           @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  reporteActividadDocencia ReporteActividadDocencia?

  // Una fila por (agenda, nombre) — sede no participa del unique para evitar
  // bypass de topes por duplicación con sedes distintas.
  @@unique([agendaId, nombre])
  @@map("actividades_docencia")
}

model ActividadInvestigacion {
  id                   String                @id @default(cuid())
  agendaId             String
  nombre               String
  descripcion          String?
  dedicacionPeriodo    Float
  cantidadUnidades     Int?
  sede                 Sede?
  agenda               AgendaSemestral       @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  reporteInvestigacion ReporteInvestigacion?

  @@unique([agendaId, nombre])
  @@map("actividades_investigacion")
}

model ActividadProyeccionSocial {
  id                String             @id @default(cuid())
  agendaId          String
  nombre            String
  descripcion       String?
  dedicacionPeriodo Float
  sede              Sede?
  agenda            AgendaSemestral    @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  reporteProyeccion ReporteProyeccion?

  @@unique([agendaId, nombre])
  @@map("actividades_proyeccion_social")
}

model ActividadGestion {
  id                String          @id @default(cuid())
  agendaId          String
  nombre            String
  descripcion       String?
  dedicacionPeriodo Float
  sede              Sede?
  agenda            AgendaSemestral @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  reporteGestion    ReporteGestion?

  @@unique([agendaId, nombre])
  @@map("actividades_gestion")
}

/// Parámetros globales del sistema (semanas, tolerancias, %, etc.)
/// Si periodoId=NULL → aplica como default permanente.
model ParametroGlobal {
  id             String            @id @default(cuid())
  periodoId      String?
  clave          String
  valor          String
  tipo           String
  descripcion    String?
  articuloOrigen String?
  activo         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String?
  periodo        PeriodoAcademico? @relation(fields: [periodoId], references: [id])

  @@unique([periodoId, clave])
  @@map("parametros_globales")
}

/// Parámetros específicos por modalidad (carga, mínimos, topes especiales)
model ParametrosModalidad {
  id                      String            @id @default(cuid())
  periodoId               String?
  modalidad               Modalidad
  sedeAplicable           Sede?
  horasSemanalMax         Int
  /// Tope semestral fijo por norma (PLANTA_TC=880, PLANTA_MT=440 — Art. 4a/4b).
  /// Si es null, se deriva en runtime: horasSemanalMax * semanasPeriodo (Art. 4c/4d/4e).
  horasSemestralMax       Int?
  horasSemestralEstricto  Boolean           @default(true)
  minDocencia             Int?
  minDocenciaConProyectos Int?
  maxInvProySocSemanal    Int?
  requiereAprobacionCA    Boolean           @default(false)
  activo                  Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  periodo                 PeriodoAcademico? @relation(fields: [periodoId], references: [id])

  @@unique([periodoId, modalidad, sedeAplicable])
  @@map("parametros_modalidad")
}

/// Coeficientes de la fórmula de horas docentes por tipo de curso × facultad
/// horas_periodo = (h_pres_sem * factorHoras + constanteSuma) * n_semanas
model FormulaCurso {
  id                      String            @id @default(cuid())
  periodoId               String?
  tipoCurso               TipoCurso
  facultad                String?
  factorHoras             Float             @default(1.5)
  constanteSuma           Float             @default(1)
  maxCreditosTrabajoIndep Int?
  articuloOrigen          String?
  activo                  Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  periodo                 PeriodoAcademico? @relation(fields: [periodoId], references: [id])

  @@unique([periodoId, tipoCurso, facultad])
  @@map("formulas_curso")
}

/// Catálogo de actividades del Art. 11 con sus topes y restricciones
model CatalogoActividad {
  id                       String             @id @default(cuid())
  categoria                CategoriaActividad
  nombre                   String
  descripcion              String?
  topeSemestralH           Int?
  topePorUnidad            UnidadTope         @default(NINGUNA)
  unidadMax                Int?
  topeSemanalHPorUnidad    Float?
  cantidadMaxSimultaneos   Int?
  restriccionTemporalAnos  Int?
  aplicaUnoPorFacultad     Boolean            @default(false)
  aplicaUnoPorSede         Boolean            @default(false)
  aplicaUnoPorPrograma     Boolean            @default(false)
  requiereResolucionRector Boolean            @default(false)
  requiereProyectoAprobado Boolean            @default(false)
  aplicaSoloAModalidades   Modalidad[]
  aplicaAPregrado          Boolean            @default(true)
  aplicaAPosgrado          Boolean            @default(true)
  articuloOrigen           String?
  activo                   Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@unique([categoria, nombre])
  @@map("catalogo_actividades")
}

/// Cargos administrativos con su asignación de horas (Art. 11 — Administrativas)
model CargoAdministrativo {
  id                       String   @id @default(cuid())
  codigo                   String   @unique
  nombre                   String
  horasAsignadas           Int
  excluyeTopeGestion20     Boolean  @default(false)
  requiereResolucionRector Boolean  @default(false)
  articuloOrigen           String?
  activo                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("cargos_administrativos")
}

/// Audit trail de rehabilitaciones de agendas enviadas (ADMIN/SUPERADMIN)
model RehabilitacionAgenda {
  id              String           @id @default(cuid())
  agendaId        String
  rehabilitadoPor String
  motivo          String
  estadoOriginal  EstadoFormulario
  fecha           DateTime         @default(now())
  observaciones   String?
  agenda          AgendaSemestral  @relation(fields: [agendaId], references: [id], onDelete: Cascade)

  @@index([agendaId])
  @@index([rehabilitadoPor])
  @@map("rehabilitaciones_agenda")
}

/// Audit trail de rehabilitaciones de monitoreos enviados (ADMIN/SUPERADMIN)
model RehabilitacionMonitoreo {
  id              String           @id @default(cuid())
  monitoreoId     String
  rehabilitadoPor String
  motivo          String
  estadoOriginal  EstadoFormulario
  fecha           DateTime         @default(now())
  observaciones   String?
  monitoreo       Monitoreo        @relation(fields: [monitoreoId], references: [id], onDelete: Cascade)

  @@index([monitoreoId])
  @@index([rehabilitadoPor])
  @@map("rehabilitaciones_monitoreo")
}

/// Proyecto de investigación o proyección social del docente.
/// Requiere aprobación del admin (Art. 3 Par. 1 Acuerdo 048) antes de poder
/// registrar horas como Investigador Principal, Coinvestigador, Coordinador o
/// Cogestor en la agenda semestral. La aprobación activa proyectosActivos en Docente.
model ProyectoDocente {
  id                  String           @id @default(cuid())
  docenteId           String
  titulo              String
  descripcion         String?
  tipo                TipoProyecto
  rolDocente          RolEnProyecto
  entidadConvocatoria String?
  periodoInicio       String?
  estado              EstadoFormulario @default(BORRADOR)
  observacionesAdmin  String?
  revisadoPor         String?
  revisadoEn          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  docente             Docente          @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  @@index([docenteId, estado])
  @@map("proyectos_docente")
}

/// Solicitud de cambio de datos de perfil del docente. Al enviarse va directo
/// a ENVIADO (sin BORRADOR persistido). El admin revisa los campos propuestos
/// y aprueba (aplicando los cambios al Docente) o rechaza con motivo.
///
/// Invariante: solo puede haber UNA solicitud en estado ENVIADO por docente a
/// la vez. Esto se valida en la server action, no como índice parcial.
model SolicitudCambioPerfil {
  id                 String           @id @default(cuid())
  docenteId          String
  estado             EstadoFormulario @default(ENVIADO)
  /// Snapshot del Docente al momento de enviar la solicitud (todos los campos
  /// editables, no solo los que cambian). Sirve para auditoría y diff.
  camposAntes        Json
  /// Solo los campos que el docente quiere cambiar (sparse).
  camposDespues      Json
  motivoSolicitud    String?
  observacionesAdmin String?
  revisadoPor        String?
  revisadoEn         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  docente            Docente          @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  @@index([docenteId, estado])
  @@map("solicitudes_cambio_perfil")
}

/// Audit log de ediciones administrativas en modo impersonación (Fase 2).
/// Una sesión comienza con accion=ABRIR, registra CAMBIO por cada mutación,
/// y termina con accion=CERRAR.
model EdicionAdministrativa {
  id            String        @id @default(cuid())
  tipo          TipoRecurso
  recursoId     String
  editorId      String
  accion        AccionEdicion
  campo         String?
  antes         Json?
  despues       Json?
  observaciones String?
  fecha         DateTime      @default(now())

  @@index([tipo, recursoId])
  @@index([editorId])
  @@map("ediciones_administrativas")
}

model Monitoreo {
  id                        String                     @id @default(cuid())
  docenteId                 String
  periodo                   String
  estado                    EstadoFormulario           @default(BORRADOR)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  agendaId                  String                     @unique
  rehabilitada              Boolean                    @default(false)
  rehabilitadaCount         Int                        @default(0)
  ultimaRehabilitacion      DateTime?
  observacionesAdmin        String?
  aprobadoPorId             String?
  aprobadoEn                DateTime?
  agenda                    AgendaSemestral            @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  docente                   Docente                    @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  aprobadoPor               Docente?                   @relation("MonitoreoAprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  rehabilitaciones          RehabilitacionMonitoreo[]
  reportesActividadDocencia ReporteActividadDocencia[]
  reportesDocencia          ReporteDocencia[]
  reportesGestion           ReporteGestion[]
  reportesInvestigacion     ReporteInvestigacion[]
  reportesProyeccion        ReporteProyeccion[]

  @@unique([docenteId, periodo])
  @@map("monitoreos")
}

/// Audita un CursoAgenda específico de la FO-19
model ReporteDocencia {
  id                  String      @id @default(cuid())
  monitoreoId         String
  cursoAgendaId       String      @unique
  horasEjecutadas     Float
  productosEntregados String?
  cursoAgenda         CursoAgenda @relation(fields: [cursoAgendaId], references: [id], onDelete: Cascade)
  monitoreo           Monitoreo   @relation(fields: [monitoreoId], references: [id], onDelete: Cascade)

  @@map("reportes_docencia")
}

/// Audita una ActividadDocencia específica de la FO-19
model ReporteActividadDocencia {
  id                  String            @id @default(cuid())
  monitoreoId         String
  actividadDocenciaId String            @unique
  horasEjecutadas     Float
  productosEntregados String?
  actividadDocencia   ActividadDocencia @relation(fields: [actividadDocenciaId], references: [id], onDelete: Cascade)
  monitoreo           Monitoreo         @relation(fields: [monitoreoId], references: [id], onDelete: Cascade)

  @@map("reportes_actividad_docencia")
}

/// Audita una ActividadInvestigacion específica de la FO-19
model ReporteInvestigacion {
  id                       String                 @id @default(cuid())
  monitoreoId              String
  actividadInvestigacionId String                 @unique
  horasEjecutadas          Float
  productosEntregados      String?
  actividadInvestigacion   ActividadInvestigacion @relation(fields: [actividadInvestigacionId], references: [id], onDelete: Cascade)
  monitoreo                Monitoreo              @relation(fields: [monitoreoId], references: [id], onDelete: Cascade)

  @@map("reportes_investigacion")
}

/// Audita una ActividadProyeccionSocial específica de la FO-19
model ReporteProyeccion {
  id                          String                    @id @default(cuid())
  monitoreoId                 String
  actividadProyeccionSocialId String                    @unique
  horasEjecutadas             Float
  productosEntregados         String?
  actividadProyeccionSocial   ActividadProyeccionSocial @relation(fields: [actividadProyeccionSocialId], references: [id], onDelete: Cascade)
  monitoreo                   Monitoreo                 @relation(fields: [monitoreoId], references: [id], onDelete: Cascade)

  @@map("reportes_proyeccion")
}

/// Audita una ActividadGestion específica de la FO-19
model ReporteGestion {
  id                  String           @id @default(cuid())
  monitoreoId         String
  actividadGestionId  String           @unique
  horasEjecutadas     Float
  productosEntregados String?
  actividadGestion    ActividadGestion @relation(fields: [actividadGestionId], references: [id], onDelete: Cascade)
  monitoreo           Monitoreo        @relation(fields: [monitoreoId], references: [id], onDelete: Cascade)

  @@map("reportes_gestion")
}

/// Log centralizado e inmutable de todas las acciones administrativas del sistema.
/// Los campos actorNombre y actorRol son snapshots: reflejan quién era el actor
/// en el momento de la acción, independientemente de cambios futuros en su perfil.
model AuditoriaLog {
  id            String          @id @default(cuid())
  actorId       String
  actorRol      Rol
  actorNombre   String
  entidad       TipoEntidad
  accion        AccionAuditoria
  recursoId     String?
  recursoDesc   String?
  antes         Json?
  despues       Json?
  observaciones String?
  creadoEn      DateTime        @default(now())

  @@index([actorId])
  @@index([entidad, creadoEn])
  @@index([accion])
  @@map("auditoria_logs")
}

/// Roles del sistema
/// SUPERADMIN: gestiona reglas paramétricas y rehabilita agendas enviadas (Fase 2+).
/// ADMIN: gestiona períodos, docentes y catálogos básicos.
/// DOCENTE: usuario final que diligencia FO-19 y FO-20.
enum Rol {
  SUPERADMIN
  ADMIN
  DOCENTE
}

/// Art. 4 — Tipos de vinculación docente
/// Cada modalidad tiene límites de carga distintos
enum Modalidad {
  PLANTA_TC
  PLANTA_MT
  OCASIONAL_TC
  OCASIONAL_MT
  CATEDRA
  VISITANTE_TC
  VISITANTE_MT
  INVITADO
}

/// Sedes oficiales de la Universidad Surcolombiana
enum Sede {
  NEIVA
  PITALITO
  GARZON
  LA_PLATA
}

/// Art. 3 Par. 4 — Clasificación del curso para fórmulas de tiempo
/// Acuerdo 033/2024 Art. 17 — Naturaleza T/T-P/P para relación T.D:T.I
enum TipoCurso {
  TEORICO
  TEORICO_PRACTICO
  PRACTICO
}

/// Categoría de actividades del docente — alinea con secciones del FO-19
enum CategoriaActividad {
  DOCENCIA
  INVESTIGACION
  PROYECCION_SOCIAL
  GESTION
}

/// Unidad sobre la cual aplica un tope (ej. 2h/sem POR_ESTUDIANTE)
enum UnidadTope {
  NINGUNA
  COHORTE
  ESTUDIANTE
  PROYECTO
  FACULTAD
  SEDE
}

/// Componente curricular (Acuerdo 033/2024 Art. 18-21)
enum ComponenteCurricular {
  BASICO_INSTITUCIONAL
  BASICO_FACULTAD
  COMPLEMENTARIO_INSTITUCIONAL
  COMPLEMENTARIO_FACULTAD
  COMPLEMENTARIO_PROGRAMA
  POSGRADO
}

/// Estados del ciclo de vida de un formulario
enum EstadoFormulario {
  BORRADOR
  ENVIADO
  APROBADO
  RECHAZADO
}

/// Estados de cuenta de un docente para acceso al sistema
enum EstadoCuenta {
  PENDIENTE
  ACTIVO
  INACTIVO
  RECHAZADO
}

/// Estados del ciclo de vida de un período académico
enum EstadoPeriodo {
  ABIERTO
  CERRADO
}

/// Recurso sobre el que un admin ejecuta una sesión de edición administrativa
enum TipoRecurso {
  AGENDA
  MONITOREO
}

/// Tipo de acción dentro de una sesión de edición administrativa
enum AccionEdicion {
  ABRIR
  CAMBIO
  CERRAR
}

// ==========================================
// AUDITORÍA CENTRALIZADA
// ==========================================

/// Categoría del recurso afectado por un evento de auditoría administrativa
enum TipoEntidad {
  PARAMETRO_GLOBAL
  PARAMETROS_MODALIDAD
  USUARIO_ROL
  USUARIO_ESTADO
  PERIODO
  AGENDA
  MONITOREO
  CURSO_MAESTRO
  SOLICITUD_PERFIL
  PROYECTO_DOCENTE
}

/// Tipo de acción de negocio que ocurrió
enum AccionAuditoria {
  CREAR
  ACTUALIZAR
  CAMBIAR_ROL
  CAMBIAR_ESTADO
  REHABILITAR
}

enum TipoProyecto {
  INVESTIGACION
  PROYECCION_SOCIAL
}

enum RolEnProyecto {
  INVESTIGADOR_PRINCIPAL
  COINVESTIGADOR
  COORDINADOR
  COGESTOR
}

/// Ámbito sobre el que aplica un cargo directivo (Art. 11). Define la dimensión
/// del cupo único: 1 Decano por FACULTAD, 1 Jefe de Programa por PROGRAMA, etc.
enum AmbitoCargo {
  FACULTAD
  PROGRAMA
  SEDE
  DEPARTAMENTO
  DEPENDENCIA
}
